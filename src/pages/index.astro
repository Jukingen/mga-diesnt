---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import BeforeAfterInlineThumbs from '../components/BeforeAfterInlineThumbs.astro';
import { getVisibleImage } from '../lib/imageUtils';
import { getEntry, getCollection } from 'astro:content';
const entry = await getEntry('pages', 'home');
if (!entry) throw new Error('Home entry not found');

const services = await getCollection('services');
const sortedServices = services.sort((a, b) => (a.data.order || 99) - (b.data.order || 99)).slice(0, 9); // Limit to top 9 or all
const { 
  title, 
  subtitle, 
  heroHeading, 
  heroText, 
  hero_background_image, 
  headerBanner,
  hero_buttons,
  about_section,
  services_section,
  cta_section
} = entry.data as any;

// Default image if none provided
const heroBg = hero_background_image || headerBanner?.image || '/images/hero-bg-placeholder.jpg';

// Fallbacks for new sections to prevent crashes if content not yet saved
const defaultHeroBtns = { primary_cta_label: "Jetzt Kontakt aufnehmen", primary_cta_link: "/kontakt", secondary_cta_label: "Unsere Leistungen", secondary_cta_link: "/leistungen" };
const finalHeroBtns = hero_buttons || defaultHeroBtns;

const defaultAbout = { heading: "Willkommen bei MIGA Dienstleistungen", content: "MIGA Dienstleistungen GmbH ist Ihr Allrounder-Team..." };
const finalAbout = about_section || defaultAbout;

const defaultServicesSec = { heading: "Unsere Leistungen", subheading: "Von Reinigung bis Sanitär – wir sind Ihr kompetenter Partner" };
const finalServicesSec = services_section || defaultServicesSec;

const defaultCTA = { heading: "Bereit für Ihr Projekt?", content: "Kontaktieren Sie uns noch heute...", primary_btn_label: "Kontakt aufnehmen", primary_btn_link: "/kontakt", secondary_btn_label: "0664 25 28 150", secondary_btn_link: "tel:+436642528150" };
const finalCTA = cta_section || defaultCTA;
---

<BaseLayout 
  title={title}
  description={subtitle || "Ihr Allround-Dienstleister in Graz"}
  headerBanner={headerBanner}
>
  <!-- Hero Section -->
  <section 
    class="relative bg-gradient-to-br from-primary-600 to-primary-800 text-white bg-cover bg-center"
    style={{ backgroundImage: `linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('${heroBg}')` }}
  >
    <div class="absolute inset-0 bg-black/20"></div>
    <div class="container-custom relative py-24 md:py-32 lg:py-40">
      <div class="max-w-3xl">
        <h1 class="heading-1 text-white mb-6">
          {heroHeading}
        </h1>
        <p class="text-xl md:text-2xl text-primary-50 mb-8">
          {heroText}
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <Button href={finalHeroBtns.primary_cta_link} variant="primary" size="lg" class="shadow-xl/20">
            {finalHeroBtns.primary_cta_label}
          </Button>
          <Button href={finalHeroBtns.secondary_cta_link} variant="secondary" size="lg" class="text-primary-700 border-white/50 hover:bg-white shadow-xl/10">
            {finalHeroBtns.secondary_cta_label}
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section class="section bg-white">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="heading-2 mb-6">{finalAbout.heading}</h2>
        <p class="text-lg text-dark-600 leading-relaxed">
          {finalAbout.content}
        </p>
      </div>
    </div>
  </section>

  <!-- Services Preview -->
  <section class="py-24 bg-gradient-to-b from-white to-gray-50">
    <div class="container-custom max-w-7xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="heading-2 mb-4">{finalServicesSec.heading}</h2>
        <p class="text-lg text-dark-600">{finalServicesSec.subheading}</p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12 items-stretch">
        {sortedServices.map((service) => {
          const data = service.data as { title: string; description?: string; banner?: { description?: string }; beforeAfter?: { beforeImage?: { src?: string; hidden?: boolean }; afterImage?: { src?: string; hidden?: boolean } } };
          const desc = service.data.banner?.description || (service.data as any).description || service.data.description;
          const beforeSrc = getVisibleImage(data.beforeAfter?.beforeImage);
          const afterSrc = getVisibleImage(data.beforeAfter?.afterImage);
          const hasBeforeAfter = !!beforeSrc && !!afterSrc;
          return (
            <a
              href={`/leistungen/${service.slug}`}
              class="group relative flex flex-col h-full rounded-2xl bg-white/80 backdrop-blur-sm border border-white/40 p-8 transition-all duration-300 ease-out shadow-[0_8px_30px_rgba(0,0,0,0.05)] hover:shadow-[0_12px_40px_rgba(0,0,0,0.08)] overflow-hidden"
            >
              <span class="absolute top-0 left-0 right-0 h-0.5 bg-primary-500 opacity-0 group-hover:opacity-100 transition-opacity duration-300" aria-hidden="true"></span>
              <div class="flex flex-col gap-4 flex-grow min-h-0">
                <h3 class="text-xl font-semibold tracking-tight text-primary-600 group-hover:text-primary-700 transition-colors flex-shrink-0">
                  {service.data.title}
                </h3>
                <p class="text-gray-600 leading-relaxed line-clamp-3 flex-grow">
                  {desc}
                </p>
                {hasBeforeAfter && (
                  <div class="mt-1">
                    <BeforeAfterInlineThumbs beforeSrc={beforeSrc} afterSrc={afterSrc} title={service.data.title} />
                  </div>
                )}
                <span class="mt-auto pt-5 relative inline-flex items-center gap-2 font-medium text-primary-600 group-hover:text-primary-700 transition-colors duration-300 after:absolute after:bottom-0 after:left-0 after:h-0.5 after:bg-primary-600 after:w-0 after:transition-all after:duration-300 group-hover:after:w-full after:content-['']">
                  Mehr erfahren
                  <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                  </svg>
                </span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section bg-gradient-to-r from-primary-600 to-primary-700 text-white">
    <div class="container-custom text-center">
      <h2 class="heading-2 text-white mb-6">{finalCTA.heading}</h2>
      <p class="text-xl text-primary-50 mb-8 max-w-2xl mx-auto">
        {finalCTA.content}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button href={finalCTA.primary_btn_link} variant="primary" size="lg" class="shadow-xl">
          {finalCTA.primary_btn_label}
        </Button>
        <Button href={finalCTA.secondary_btn_link} variant="secondary" size="lg" class="text-primary-700 border-transparent hover:bg-white shadow-xl">
          {finalCTA.secondary_btn_label}
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
