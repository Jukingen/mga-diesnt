---
import { getEntry, getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import ServiceCard from '../components/ServiceCard.astro';
import VorherNachherModal from '../components/VorherNachherModal.astro';
import { getVisibleImage } from '../lib/imageUtils';

const services = await getCollection('services');
const sortedServices = services.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));

const DEFAULT_BANNER_IMAGE = '/assets/uploads/default-service-banner.jpg';
const FALLBACK_TITLE = 'Unsere Leistungen';
const FALLBACK_BANNER_TEXT = 'Professionelle Dienstleistungen für jeden Bedarf';
const FALLBACK_CTA = {
  heading: 'Interesse an unseren Leistungen?',
  content: 'Kontaktieren Sie uns für ein unverbindliches Angebot',
  button_text: 'Jetzt Kontakt aufnehmen',
  button_link: '/kontakt'
};

const entry = await getEntry('pages', 'services');
const { title: pageTitle, headerBanner, seo, cta_section, intro_text } = (entry?.data || {}) as { intro_text?: string };
// Fallback: meta_title → seo.title → page title; meta_description → seo.description → default
const finalTitle = (seo as any)?.meta_title || seo?.title || pageTitle || FALLBACK_TITLE;
const finalDescription = (seo as any)?.meta_description || seo?.description || "Professionelle Dienstleistungen: Reinigung, Grünflächenpflege, Winterdienst, Transport, Tischler-, Montage-, Bauarbeiten und Sanitär in Graz und Steiermark.";
const finalSubtitle = headerBanner?.text || FALLBACK_BANNER_TEXT;
const finalImage = headerBanner?.image || DEFAULT_BANNER_IMAGE;
const isBannerEnabled = headerBanner?.enabled !== false;
const bannerVariant = headerBanner?.variant || 'dark';

const finalCTA = {
  heading: cta_section?.heading || FALLBACK_CTA.heading,
  content: cta_section?.content || FALLBACK_CTA.content,
  button_text: cta_section?.button_text || FALLBACK_CTA.button_text,
  button_link: cta_section?.button_link || FALLBACK_CTA.button_link
};

const computedHeaderBanner = {
  enabled: isBannerEnabled,
  text: finalTitle,
  image: finalImage,
  variant: bannerVariant,
};
---

<BaseLayout
  title={finalTitle}
  description={finalDescription}
  image={seo?.og_image || headerBanner?.image}
  headerBanner={computedHeaderBanner}
>
  <!-- Hero -->
  <section class="relative bg-gradient-to-r from-primary-600 to-primary-700 text-white py-16 overflow-hidden">
    {finalImage && finalImage !== DEFAULT_BANNER_IMAGE && (
      <div class="absolute inset-0 z-0">
        <img
          src={finalImage}
          alt={`${finalTitle} – Professionelle Dienstleistungen in Graz und Steiermark`}
          class="w-full h-full object-cover opacity-90"
          loading="eager"
          decoding="async"
          width="1200"
          height="400"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-black/40 to-black/20"></div>
      </div>
    )}
    <div class="container-custom relative z-10 drop-shadow-lg">
      <h1 class="heading-1 text-white mb-4">{finalTitle}</h1>
      <p class="text-xl text-white font-medium">{finalSubtitle}</p>
    </div>
  </section>

  <!-- SEO Intro Text (250-500 Wörter für lokale Keywords) -->
  {intro_text && (
    <section class="section bg-white">
      <div class="container-custom max-w-4xl mx-auto prose prose-lg prose-primary max-w-none" set:html={(await import('marked')).marked.parse(intro_text)} />
    </section>
  )}

  <!-- Services Grid: overflow-visible so floating thumbs don't get clipped -->
  <section class="py-20 md:py-24 bg-gradient-to-b from-white to-slate-50 overflow-visible">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10 md:gap-12 items-stretch">
        {sortedServices.map((service) => {
          const data = service.data as {
            title: string;
            description?: string;
            image?: string;
            banner?: { image?: string };
            beforeAfter?: {
              beforeImage?: { src?: string; hidden?: boolean };
              afterImage?: { src?: string; hidden?: boolean };
            };
          };
          const cardImage = data.banner?.image ?? data.image;
          return (
            <ServiceCard
              slug={service.slug}
              title={data.title}
              description={data.description}
              cardImage={cardImage}
              beforeAfter={data.beforeAfter}
            />
          );
        })}
      </div>
    </div>
  </section>

  <!-- Modals: page-level (kart transform'undan etkilenmez, fullscreen) -->
  {sortedServices.map((service) => {
    const data = service.data as { title: string; beforeAfter?: { beforeImage?: { src?: string; hidden?: boolean }; afterImage?: { src?: string; hidden?: boolean } } };
    const beforeSrc = getVisibleImage(data.beforeAfter?.beforeImage);
    const afterSrc = getVisibleImage(data.beforeAfter?.afterImage);
    if (!beforeSrc && !afterSrc) return null;
    return (
      <VorherNachherModal
        id={service.slug}
        beforeSrc={beforeSrc || ''}
        afterSrc={afterSrc || ''}
        title={data.title}
      />
    );
  })}

  <!-- CTA -->
  <section class="section bg-gradient-to-r from-primary-600 to-primary-700 text-white">
    <div class="container-custom text-center">
      <h2 class="heading-2 text-white mb-6">{finalCTA.heading}</h2>
      <p class="text-xl text-primary-50 mb-8">{finalCTA.content}</p>
      <Button href={finalCTA.button_link} variant="primary" size="lg" class="shadow-xl">{finalCTA.button_text}</Button>
    </div>
  </section>
</BaseLayout>
