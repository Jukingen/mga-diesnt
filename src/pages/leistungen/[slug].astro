---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StructuredData from '../../components/StructuredData.astro';
import Button from '../../components/Button.astro';
import BeforeAfterGallery from '../../components/BeforeAfterGallery.astro';
import { getVisibleImage } from '../../lib/imageUtils';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const { title, description: legacyDescription, items: legacyItems, image: legacyImage, banner, seo, beforeAfter } = entry.data;

// Fallback logic for Banner fields
const bannerTitle = banner?.title || title;
const bannerDescription = banner?.description || legacyDescription;
const bannerImage = banner?.image || legacyImage;

// SEO fallback: meta_title → seo.title → default; meta_description → seo.description → generated
const pageTitle = (seo as any)?.meta_title || seo?.title || `${title} - MIGA Dienstleistungen GmbH`;
const pageDescription = (seo as any)?.meta_description || seo?.description || legacyDescription || `Professionelle ${title} in Graz und Steiermark. MIGA Dienstleistungen – Ihr zuverlässiger Partner.`;

const hasLegacyItems = legacyItems && legacyItems.length > 0;

const beforeSrc = getVisibleImage(beforeAfter?.beforeImage);
const afterSrc = getVisibleImage(beforeAfter?.afterImage);
const hasBeforeAfter = !!beforeSrc && !!afterSrc;
const allServices = (await getCollection('services')).sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<BaseLayout title={pageTitle} description={pageDescription} image={(seo as any)?.og_image || bannerImage}>
  <StructuredData service={{ name: title, description: pageDescription, areaServed: ['Graz', 'Steiermark', 'Umgebung'] }} />
  <!-- Header -->
  <section class="relative bg-gradient-to-r from-primary-600 to-primary-700 text-white py-16 overflow-hidden">
    {bannerImage && (
      <div class="absolute inset-0 z-0">
        <img
          src={bannerImage}
          alt={`${bannerTitle} – ${title} in Graz und Steiermark`}
          class="w-full h-full object-cover opacity-20 mix-blend-overlay"
          loading="eager"
          decoding="async"
          width="1200"
          height="400"
          onerror="this.onerror=null;this.style.display='none'"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-primary-900/80 to-primary-800/60"></div>
      </div>
    )}
    
    <div class="container-custom relative z-10">
      <h1 class="heading-1 text-white mb-4">{bannerTitle}</h1>
      {bannerDescription && <p class="text-xl text-primary-50 max-w-2xl">{bannerDescription}</p>}
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-custom">
      <div class="flex flex-col md:flex-row gap-8">
        <div class="md:w-2/3">
           {/* Main Content from Markdown */}
           <div class="prose prose-lg prose-primary mb-12 max-w-none">
              <Content />
           </div>

           {/* Vorher/Nachher Block - nur wenn beide Bilder vorhanden */}
           {hasBeforeAfter && (
             <section class="mb-12">
               <BeforeAfterGallery
                 beforeSrc={beforeSrc}
                 afterSrc={afterSrc}
                 caption={beforeAfter?.caption}
                 title={title}
                 modalId={entry.slug}
               />
             </section>
           )}

           {/* Legacy Items List - Only shown if items exist */}
           {hasLegacyItems && (
            <div class="mb-12">
               <h2 class="heading-3 mb-6 text-primary-600">Leistungsübersicht</h2>
               <ul class="grid grid-cols-1 gap-3 text-dark-700">
                 {legacyItems.map((item) => (
                   <li class="flex items-start">
                     <span class="text-primary-600 mr-2 mt-1">
                       <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                         <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                       </svg>
                     </span>
                     <span class="text-lg">{item}</span>
                   </li>
                 ))}
               </ul>
            </div>
           )}

          <div class="bg-gray-50 p-6 rounded-lg border border-gray-100">
            <h3 class="text-xl font-bold mb-4">Haben Sie Fragen zu diesem Bereich?</h3>
            <p class="mb-6">Wir beraten Sie gerne persönlich zu unseren Leistungen im Bereich {title}.</p>
            <Button href="/kontakt" variant="primary">Jetzt anfragen</Button>
          </div>
        </div>

        <aside class="md:w-1/3">
          <div class="bg-gray-50 p-6 rounded-lg border border-gray-100 sticky top-24">
            <h3 class="text-lg font-bold mb-4 border-b pb-2">Alle Leistungen</h3>
            <nav class="flex flex-col space-y-2">
              {allServices.map((s) => (
                <a
                  href={`/leistungen/${s.slug}`}
                  class={`block p-2 rounded hover:bg-white hover:shadow-sm transition-colors ${s.slug === entry.slug ? 'font-bold text-primary-600 bg-white shadow-sm' : 'text-gray-700'}`}
                >
                  {s.data.title}
                </a>
              ))}
              <div class="pt-4 border-t mt-4">
                 <a href="/leistungen" class="text-sm text-primary-600 hover:text-primary-700 flex items-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
                    </svg>
                    Zur Übersicht
                 </a>
              </div>
            </nav>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>
