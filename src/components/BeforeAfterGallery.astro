---
/**
 * Vorher/Nachher-Galerie: İki görsel yan yana, caption, tıklanınca ortak modal.
 */
import VorherNachherModal from './VorherNachherModal.astro';

interface Props {
  beforeSrc: string;
  afterSrc: string;
  caption?: string;
  title: string;
  /** Modal ID için (alt sayfa slug vb.) */
  modalId?: string;
}
const { beforeSrc, afterSrc, caption, title, modalId = 'gallery' } = Astro.props;
const baseAlt = `${title} – Vorher/Nachher`;
const vnModalId = `vorher-nachher-modal-${modalId}`;
---

<section class="before-after-gallery rounded-2xl overflow-hidden border border-gray-100 bg-gray-50/50">
  <div class="p-6 md:p-8">
    <h3 class="heading-4 mb-6 text-primary-600">Vorher & Nachher</h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
      {beforeSrc && (
      <div class="relative group">
        <span class="absolute top-3 left-3 z-10 px-3 py-1.5 text-xs font-semibold uppercase tracking-wider bg-primary-600 text-white rounded-lg shadow-md">
          Vorher
        </span>
        <button
          type="button"
          class="image-trigger w-full aspect-[4/3] overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 cursor-zoom-in block"
          data-vorher-nachher-modal={vnModalId}
          data-initial="vorher"
          aria-label="Vorher-Bild vergrößern"
        >
          <img
            src={beforeSrc}
            alt={`${baseAlt} - Vorher`}
            class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
            loading="eager"
            decoding="async"
            width="400"
            height="300"
            onerror="this.onerror=null;this.style.display='none'"
          />
        </button>
      </div>
      )}
      {afterSrc && (
      <div class="relative group">
        <span class="absolute top-3 left-3 z-10 px-3 py-1.5 text-xs font-semibold uppercase tracking-wider bg-primary-600 text-white rounded-lg shadow-md">
          Nachher
        </span>
        <button
          type="button"
          class="image-trigger w-full aspect-[4/3] overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 cursor-zoom-in block"
          data-vorher-nachher-modal={vnModalId}
          data-initial="nachher"
          aria-label="Nachher-Bild vergrößern"
        >
          <img
            src={afterSrc}
            alt={`${baseAlt} - Nachher`}
            class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
            loading="eager"
            decoding="async"
            width="400"
            height="300"
            onerror="this.onerror=null;this.style.display='none'"
          />
        </button>
      </div>
      )}
    </div>
    {caption && (
      <p class="mt-5 text-gray-600 text-sm md:text-base leading-relaxed">{caption}</p>
    )}
  </div>
</section>

<VorherNachherModal id={modalId} beforeSrc={beforeSrc || ''} afterSrc={afterSrc || ''} title={title} />

<style>
  @media (prefers-reduced-motion: reduce) {
    .before-after-gallery img {
      transition: none;
    }
  }
</style>
