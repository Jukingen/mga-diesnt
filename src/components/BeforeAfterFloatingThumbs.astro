---
/**
 * Kartın üstünde before/after thumbnails (relative flow, mobil uyumlu).
 * Tıklanınca ortak VorherNachherModal açılır.
 */
import VorherNachherModal from './VorherNachherModal.astro';

interface Props {
  beforeSrc?: string;
  afterSrc?: string;
  title?: string;
  id: string;
  placeholder?: boolean;
}
const { beforeSrc = '', afterSrc = '', title = '', id, placeholder = false } = Astro.props;
const vnModalId = `vorher-nachher-modal-${id}`;
const baseAlt = `${title} – Vorher/Nachher`;
const thumbClass = 'relative shrink-0 w-[88px] h-[64px] sm:w-[100px] sm:h-[76px] rounded-xl overflow-hidden border border-slate-100';
const containerClass = 'flex gap-2 rounded-2xl bg-slate-50/70 border border-slate-100 p-2.5';
---

<!-- Relative flow: üstte thumb strip, altında kart content -->
<div class="flex flex-col w-full" data-before-after-thumbs role="presentation">
  <div class="flex justify-center mb-5 px-1 sm:px-0">
    <div class={containerClass}>
      {placeholder ? (
        <>
          <div class={`${thumbClass} cursor-default bg-gradient-to-br from-slate-50 to-slate-100/80 flex items-center justify-center`} aria-hidden="true">
            <span class="absolute top-1 left-1 z-10 px-1.5 py-0.5 text-[10px] font-medium text-slate-400 opacity-70">Vorher</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-slate-300/80 sm:h-7 sm:w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <div class={`${thumbClass} cursor-default bg-gradient-to-br from-slate-50 to-slate-100/80 flex items-center justify-center`} aria-hidden="true">
            <span class="absolute top-1 left-1 z-10 px-1.5 py-0.5 text-[10px] font-medium text-slate-400 opacity-70">Nachher</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-slate-300/80 sm:h-7 sm:w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
        </>
      ) : (
        <>
          {beforeSrc && (
          <button
            type="button"
            class={`thumb-trigger ${thumbClass} focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 transition-transform duration-200 hover:scale-[1.02]`}
            data-vorher-nachher-modal={vnModalId}
            data-initial="vorher"
            aria-label="Vorher-Bild vergrößern"
          >
            <span class="absolute top-1 left-1 z-10 px-1.5 py-0.5 text-[10px] font-medium bg-white/90 border border-gray-200 rounded-full text-gray-600 shadow-sm">
              Vorher
            </span>
            <img
              src={beforeSrc}
              alt={`${baseAlt} - Vorher`}
              class="absolute inset-0 w-full h-full object-cover min-w-0 min-h-0"
              loading="lazy"
              decoding="async"
              width="100"
              height="76"
              onerror="this.onerror=null;this.style.display='none'"
            />
          </button>
          )}
          {afterSrc && (
          <button
            type="button"
            class={`thumb-trigger ${thumbClass} focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 transition-transform duration-200 hover:scale-[1.02]`}
            data-vorher-nachher-modal={vnModalId}
            data-initial="nachher"
            aria-label="Nachher-Bild vergrößern"
          >
            <span class="absolute top-1 left-1 z-10 px-1.5 py-0.5 text-[10px] font-medium bg-white/90 border border-gray-200 rounded-full text-gray-600 shadow-sm">
              Nachher
            </span>
            <img
              src={afterSrc}
              alt={`${baseAlt} - Nachher`}
              class="absolute inset-0 w-full h-full object-cover min-w-0 min-h-0"
              loading="lazy"
              decoding="async"
              width="100"
              height="76"
              onerror="this.onerror=null;this.style.display='none'"
            />
          </button>
          )}
        </>
      )}
    </div>
  </div>
</div>

{!placeholder && (beforeSrc || afterSrc) && (
  <VorherNachherModal id={id} beforeSrc={beforeSrc || ''} afterSrc={afterSrc || ''} title={title} />
)}
