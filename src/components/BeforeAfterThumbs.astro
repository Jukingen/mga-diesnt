---
/**
 * Vorher/Nachher thumbnail preview: Badgesiz, temiz görünüm.
 * Meta satırı kart başlığı üstünde ayrı render edilir.
 */
interface Props {
  beforeSrc: string;
  afterSrc: string;
  title: string;
}
const { beforeSrc, afterSrc, title } = Astro.props;
---

<div class="flex flex-row gap-2.5 bg-gray-50/50 rounded-xl p-2.5 border border-gray-100 min-h-[72px]">
  <div class="relative flex-1 min-w-0 h-14 rounded-lg overflow-hidden border border-gray-100 bg-white/80 transition-all duration-200 hover:scale-[1.02] hover:shadow-sm">
    <img
      src={beforeSrc}
      alt={`${title} – Vorher`}
      class="w-full h-full object-cover"
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="relative flex-1 min-w-0 h-14 rounded-lg overflow-hidden border border-gray-100 bg-white/80 transition-all duration-200 hover:scale-[1.02] hover:shadow-sm">
    <img
      src={afterSrc}
      alt={`${title} – Nachher`}
      class="w-full h-full object-cover"
      loading="lazy"
      decoding="async"
    />
  </div>
</div>
