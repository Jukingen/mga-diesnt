---
/**
 * Leistungen liste sayfası – tatlı kutu tarzı premium kart.
 * Before/After thumbnail strip sadece beforeImage+afterImage olan kartlarda.
 */
import BeforeAfterFloatingThumbs from './BeforeAfterFloatingThumbs.astro';
import { getVisibleImage } from '../lib/imageUtils';

interface Props {
  slug: string;
  title: string;
  description?: string;
  cardImage?: string;
  beforeAfter?: { beforeImage?: { src?: string; hidden?: boolean }; afterImage?: { src?: string; hidden?: boolean } };
}

const { slug, title, description, cardImage, beforeAfter } = Astro.props;

const beforeSrc = getVisibleImage(beforeAfter?.beforeImage);
const afterSrc = getVisibleImage(beforeAfter?.afterImage);
const hasBeforeAfter = !!beforeSrc && !!afterSrc;

/** cardImage banner/image string path; guard ile render. */
const showCardImage = cardImage && cardImage.trim();
---

<!-- Outer: relative overflow-visible, hover tüm kartı kaldırır -->
<div class="card-outer h-full relative overflow-visible group/card hover:-translate-y-[3px] transition-transform duration-300 ease-out">
  <!-- Floating Vorher/Nachher: kartın üstünde, box dışında -->
  <div class="ba-floating absolute left-1/2 -translate-x-1/2 -top-8 sm:-top-10 z-10 w-[calc(100%-2rem)] max-w-[220px] drop-shadow-md">
    <BeforeAfterFloatingThumbs
      beforeSrc={beforeSrc}
      afterSrc={afterSrc}
      title={title}
      id={slug}
      placeholder={!hasBeforeAfter}
    />
  </div>
  <!-- Inner card: rounded, shadow, content – floating için pt -->
  <div class="card-inner h-full flex flex-col rounded-3xl bg-white border border-slate-100 p-8 pt-20 sm:pt-24 shadow-[0_4px_14px_rgba(0,0,0,0.04)] group-hover/card:shadow-[0_12px_28px_rgba(0,0,0,0.08)] group-hover/card:border-blue-100 transition-all duration-300 ease-out">
  <a
    href={`/leistungen/${slug}`}
    class="group block flex flex-col flex-grow min-h-0"
  >
    {showCardImage && (
      <div class="rounded-2xl overflow-hidden flex-shrink-0 mb-6">
        <img
          src={cardImage!.startsWith('/') ? cardImage : `/${cardImage}`}
          alt={title}
          class="w-full aspect-video object-cover transition-transform duration-300 ease-out group-hover:scale-[1.02]"
          loading="lazy"
          onerror="this.onerror=null;this.style.display='none'"
        />
      </div>
    )}
    <div class="flex flex-col flex-grow min-h-0">
      <h2 class="text-xl font-semibold tracking-tight text-gray-900 group-hover:text-primary-600 transition-colors duration-300">
        {title}
      </h2>
      <p class="mt-3 text-slate-600 leading-relaxed max-w-[32ch] line-clamp-3 flex-grow">
        {description}
      </p>
      <div class="mt-auto pt-6">
        <span class="inline-flex items-center gap-2 font-medium text-primary-600 group-hover:text-primary-700 transition-colors duration-300">
          Mehr erfahren
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </span>
      </div>
    </div>
  </a>
  </div>
</div>
