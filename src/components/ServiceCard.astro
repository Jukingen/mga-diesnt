---
/**
 * Leistungen liste sayfası – Apple tarzı ultra minimal kart.
 * Before/After thumbnail strip sadece beforeImage+afterImage olan kartlarda.
 */
import BeforeAfterFloatingThumbs from './BeforeAfterFloatingThumbs.astro';

interface Props {
  slug: string;
  title: string;
  description?: string;
  cardImage?: string;
  beforeAfter?: { beforeImage?: string; afterImage?: string };
}

const { slug, title, description, cardImage, beforeAfter } = Astro.props;

function normImg(v: string | { url?: string; path?: string } | undefined): string {
  if (!v) return '';
  if (typeof v === 'string') return v.startsWith('/') ? v : `/${v}`;
  const u = (v as { url?: string; path?: string }).url ?? (v as { path?: string }).path;
  return u ? (u.startsWith('/') ? u : `/${u}`) : '';
}

const beforeSrc = normImg(beforeAfter?.beforeImage);
const afterSrc = normImg(beforeAfter?.afterImage);
const hasBeforeAfter = !!beforeSrc && !!afterSrc;
---

<div class="h-full flex flex-col">
  {hasBeforeAfter && (
    <BeforeAfterFloatingThumbs
      beforeSrc={beforeSrc}
      afterSrc={afterSrc}
      title={title}
      id={slug}
    />
  )}
  <a
    href={`/leistungen/${slug}`}
    class="group block flex-grow min-h-0 rounded-3xl bg-transparent p-0 flex flex-col transition-all duration-500 ease-out hover:scale-[1.015]"
  >
    {cardImage && (
      <div class="rounded-2xl overflow-hidden flex-shrink-0 mb-6">
        <img
          src={cardImage}
          alt={title}
          class="w-full aspect-video object-cover transition-transform duration-500 ease-out group-hover:scale-[1.02]"
          loading="lazy"
        />
      </div>
    )}
    <div class="flex flex-col flex-grow min-h-0">
      <h2 class="text-2xl font-medium tracking-tight text-gray-900 group-hover:text-primary-600 transition-colors duration-500">
        {title}
      </h2>
      <p class="mt-4 text-gray-500 leading-relaxed max-w-[32ch] line-clamp-3 flex-grow">
        {description}
      </p>
      <div class="mt-auto pt-8">
        <span class="inline-flex items-center gap-2 text-primary-600 font-medium transition-all duration-300 group-hover:gap-3">
          Mehr erfahren
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </span>
      </div>
    </div>
  </a>
</div>
